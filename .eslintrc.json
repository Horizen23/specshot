{
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "env": {
    "node": true,
    "es2022": true
  },
  "rules": {
    "no-unused-vars": "off",
    "no-console": "warn",
    "no-undef": "off"
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "examples",
    "templates",
    "ui/mock-ui/dist",
    "scratch"
  ]
}
